<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/linen"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="20dp"
            android:paddingBottom="4dp"
            android:text="@string/label_suggested_recipes"
            android:textAppearance="@style/TextAppearance.Pantry.ScreenTitle" />

        <LinearLayout
            android:id="@+id/layout_empty_suggestions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_empty_suggestions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_suggestions_headline"
                android:textAppearance="@style/TextAppearance.Pantry.EmptyHeadline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/empty_suggestions_sub"
                android:textAppearance="@style/TextAppearance.Pantry.BodyMuted" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_suggested_recipes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:background="@color/hairline" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="4dp"
            android:text="@string/label_almost_there"
            android:textAppearance="@style/TextAppearance.Pantry.SectionTitle" />

        <LinearLayout
            android:id="@+id/layout_empty_almost_there"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_empty_almost_there"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_almost_there_headline"
                android:textAppearance="@style/TextAppearance.Pantry.EmptyHeadline" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/empty_almost_there_sub"
                android:textAppearance="@style/TextAppearance.Pantry.BodyMuted" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_almost_there"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
